// ====== DATA MODELS ====== class PlayRecord { final String id; final String title; final String type; // music | video | series | sport final DateTime playedAt; PlayRecord({required this.id, required this.title, required this.type, required this.playedAt});

Map<String, dynamic> toMap() => { 'id': id, 'title': title, 'type': type, 'playedAt': playedAt.millisecondsSinceEpoch, };

static PlayRecord from(Map m) => PlayRecord( id: m['id'], title: m['title'], type: m['type'], playedAt: DateTime.fromMillisecondsSinceEpoch(m['playedAt']), ); }

class SettingsModel with ChangeNotifier { bool hideInAppAds = true; // app-level ads toggle (cannot block third-party ads) bool autoRotateVideo = true; bool recommendationsOn = true;

void toggleAds(bool v) { hideInAppAds = v; notifyListeners(); } void toggleRotate(bool v) { autoRotateVideo = v; notifyListeners(); } void toggleRecs(bool v) { recommendationsOn = v; notifyListeners(); } }

class HistoryModel with ChangeNotifier { late Box _box; List<PlayRecord> items = [];

Future init() async { _box = await Hive.openBox('history'); items = _box.values .map((e) => PlayRecord.from(Map<String, dynamic>.from(e))) .toList() ..sort((a, b) => b.playedAt.compareTo(a.playedAt)); notifyListeners(); }

Future add(PlayRecord r) async { await _box.add(r.toMap()); items.insert(0, r); notifyListeners(); } }

